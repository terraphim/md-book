<!DOCTYPE html>
<html lang="{{ config.book.language }}"
      data-default-theme="{{ default_theme }}"
      data-preferred-dark-theme="{{ preferred_dark_theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Not Found | {{ config.book.title }}</title>
  <link rel="stylesheet" href="{{ path_to_root | safe }}css/styles.css">
  <link rel="stylesheet" href="{{ path_to_root | safe }}css/themes.css">
</head>
<body>
  <main class="content">
    {% if custom_404 %}
    {{ custom_404 | safe }}
    <p><a href="{{ path_to_root | safe }}index.html">Back to home</a></p>
    {% else %}
    <h1>404</h1>
    <p>Page not found.</p>
    <p><a href="{{ path_to_root | safe }}index.html">Back to home</a></p>
    {% endif %}
  </main>
  <script src="{{ path_to_root | safe }}js/theme-switch.js"></script>
</body>
</html>
