<!DOCTYPE html>
<html lang="{{ config.book.language }}"
      data-default-theme="{{ default_theme }}"
      data-preferred-dark-theme="{{ preferred_dark_theme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ config.book.title }}</title>
    <!-- Include Shoelace assets -->
    <link rel="stylesheet" href="{{ path_to_root }}vendor/shoelace/themes/light.css" />
    <script type="module" src="{{ path_to_root }}vendor/shoelace/shoelace-local.js"></script>
    <link rel="stylesheet" href="{{ path_to_root }}css/styles.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/themes.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/search.css">
    <script type="module" src="{{ path_to_root }}components/simple-block.js"></script>
    <script src="{{ path_to_root }}js/pagefind-search.js" type="module"></script>
    <script src="{{ path_to_root }}components/search-modal.js" type="module"></script>
    <script src="{{ path_to_root }}js/search-init.js" type="module"></script>
    {% if has_mermaid %}
    <script src="{{ path_to_root }}js/mermaid.min.js" type="module"></script>
    <script src="{{ path_to_root }}js/mermaid-init.js" type="module"></script>
    {% endif %}
</head>
<body>
    <div class="container index-container">
        {% include "header" %}
        <main class="content index-content">
            {% if has_index %}
                <article class="main-article">
                    {{ content | safe }}
                </article>
            {% else %}
                <div class="index-header">
                    <h1>Documentation</h1>
                </div>
                <div class="card-grid">
                    {% for section in sections %}
                        <div class="section-group">
                            <h2>{{ section.title }}</h2>
                            <div class="card-group">
                                {% for page in section.pages %}
                                    <sl-card class="doc-card">
                                        <h3 slot="header">{{ page.title }}</h3>
                                        <sl-button href="{{ path_to_root }}{{ page.path }}" variant="default">
                                            Read More
                                            <sl-icon slot="suffix" name="arrow-right"></sl-icon>
                                        </sl-button>
                                    </sl-card>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </main>
    </div>
    
    <!-- Search Modal -->
    <search-modal></search-modal>
    <script src="{{ path_to_root }}js/theme-switch.js"></script>
    <script src="{{ path_to_root }}js/keyboard.js"></script>
    <script src="{{ path_to_root }}js/code-copy.js"></script>
</body>
</html> 